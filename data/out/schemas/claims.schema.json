{
 "$ref": "#/definitions/claims",
 "definitions": {
  "claims": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "source_edition_id": {
     "type": "string",
     "minLength": 1
    },
    "quote": {
     "type": "string",
     "minLength": 1,
     "maxLength": 400
    },
    "statement": {
     "type": "string",
     "minLength": 1,
     "maxLength": 400
    },
    "statement_generated": {
     "type": "boolean"
    },
    "position": {
     "type": "string"
    },
    "subject_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "claim_type": {
     "type": "string",
     "enum": [
      "forecast",
      "trend",
      "scenario",
      "ranking",
      "fiction"
     ]
    },
    "metric": {
     "type": "string"
    },
    "direction": {
     "type": "string",
     "enum": [
      "up",
      "down",
      "arrive",
      "persist",
      "other"
     ]
    },
    "value": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "target_date": {
     "type": "string",
     "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
    },
    "horizon_band": {
     "type": "string"
    },
    "phase": {
     "type": "string",
     "enum": [
      "innovation_trigger",
      "peak",
      "trough",
      "slope",
      "plateau"
     ]
    },
    "hedge": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "status": {
     "type": "string",
     "enum": [
      "open",
      "resolved",
      "contested"
     ]
    },
    "published": {
     "type": "boolean"
    }
   },
   "required": [
    "id",
    "source_edition_id",
    "subject_ids",
    "claim_type",
    "status",
    "published"
   ],
   "additionalProperties": false
  }
 },
 "$schema": "http://json-schema.org/draft-07/schema#"
}
